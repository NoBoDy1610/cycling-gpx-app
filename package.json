{
  "name": "cycling-gpx-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*"],
  "engines": { "node": ">=24.11.0 <25" },
  "scripts": {
    "dev:api": "npm run dev --workspace @cycling-gpx/api",
    "dev:web": "npm run dev --workspace @cycling-gpx/web",
    "start:api": "npm run start --workspace @cycling-gpx/api",
    "preview:web": "npm run preview --workspace @cycling-gpx/web",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "test:integration": "RUN_DATABASE_TESTS=1 node --env-file-if-exists=.env --run test:integration:run",
    "test:integration:run": "npm run db:migrate && vitest run integration.test.ts",
    "db:generate": "npm run db:generate --workspace @cycling-gpx/api",
    "db:migrate": "npm run db:migrate --workspace @cycling-gpx/api"
  },
  "overrides": {
    "@prisma/config": { "effect": "3.22.1" }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0"
  }
}
